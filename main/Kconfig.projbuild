menu "Rocket Launch Controller"

    choice RLC_UNIT_TYPE
        prompt "Unit type"
        default RLC_UNIT_BASE
        help
            Select whether to build firmware for the Base unit or the Remote unit.

        config RLC_UNIT_BASE
            bool "Base Unit"
            help
                Build firmware for the base (launch pad) unit.

        config RLC_UNIT_REMOTE
            bool "Remote Unit"
            help
                Build firmware for the remote (operator) unit.
    endchoice

    config RLC_SERIAL_DEBUG_LOGGING
        bool "Enable serial debug logging"
        default y
        help
            Enable UART0 log output at runtime. When disabled, no serial
            logging is produced (field operation mode).

endmenu
