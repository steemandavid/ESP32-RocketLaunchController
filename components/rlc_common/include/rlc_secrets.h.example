/**
 * RLC Shared Secrets — TEMPLATE
 *
 * Copy to rlc_secrets.h and fill with real random values, or just run:
 *
 *     ./tools/gen-secrets.sh
 *
 * rlc_secrets.h is gitignored and MUST NOT be committed. A pre-commit hook
 * (tools/git-hooks/pre-commit) refuses commits that contain key material;
 * install it with:
 *
 *     git config core.hooksPath tools/git-hooks
 *
 * Both units must hold the SAME keys. ESP-NOW encryption fails before the
 * firmware version check does, so a half-flashed pair does not merely refuse
 * to link — it cannot talk at all, with no diagnostic. Flash both together.
 *
 * Bug #20: these keys previously lived in rlc_config.h, committed to a public
 * repository, and were ASCII placeholders ("RLC_PMK_DEFAULT!") that had never
 * been changed. Those values are permanently compromised and must never be
 * reused — rotating away from them is the whole point of this file.
 */

#pragma once

/* ESP-NOW primary master key (16 bytes) */
#define ESPNOW_PMK  { \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
}

/* ESP-NOW local master key, per-peer (16 bytes) */
#define ESPNOW_LMK  { \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
}

/* Pre-shared key for the CRC32-C integrity check (16 bytes) */
#define CMD_INTEGRITY_KEY  { \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
}
